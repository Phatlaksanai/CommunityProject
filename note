ตาราง database
create table users(
    user_id int auto_increment primary key,
    username varchar(255),
    password varchar(255),
    email varchar(255),
    otp varchar(6),
    otp_expire datetime
);

ALTER TABLE users ADD UNIQUE(email); //email เดิมจะ insert ไม่ได้ซ้ำอีก

SET FOREIGN_KEY_CHECKS = 0; //ลบข้อมูลในตารางทั้งหมด
TRUNCATE TABLE users;
SET FOREIGN_KEY_CHECKS = 1;

CREATE TABLE users (
    user_id INT AUTO_INCREMENT PRIMARY KEY,
    username VARCHAR(45) NOT NULL,
    password VARCHAR(45) NOT NULL,
    email VARCHAR(45) NOT NULL,
    otp VARCHAR(6),
    otp_expire DATETIME,
    name VARCHAR(45),
    profilePic VARCHAR(200),
    coverPic VARCHAR(200),
    city VARCHAR(45),
    website VARCHAR(200)
);

CREATE TABLE comment (
    comment_id INT AUTO_INCREMENT PRIMARY KEY,
    description VARCHAR(200) NOT NULL,
    img VARCHAR(200),
    createAt DATETIME DEFAULT CURRENT_TIMESTAMP,
    user_id INT NOT NULL,
    post_id INT NOT NULL
);

Supabase
ใน SQL Editor
CREATE TYPE category_type AS ENUM (
  'Vehicles',
  'Electronics',
  'Characters',
  'Furniture',
  'Sports',
  'Food&Drink'
);

CREATE TYPE status_friendships AS ENUM (
  'pending', 'accepted', 'declined' 
);

CREATE TYPE status_messages AS ENUM (
  'read', 'sending', 'sent', 'failed'  
);

create type status_post as enum (
  'show',
  'hide'
);

create type isdelete as enum (
  'active',
  'deleted'
);

create type role as enum (
  'admin'
);

create type report_type as enum (
  'copyright' ,'inappropriate' ,'spam' ,'scam' ,'other' 
);