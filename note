ตาราง database
create table users(
    user_id int auto_increment primary key,
    username varchar(255),
    password varchar(255),
    email varchar(255),
    otp varchar(6),
    otp_expire datetime
);

ALTER TABLE users ADD UNIQUE(email); //email เดิมจะ insert ไม่ได้ซ้ำอีก
TRUNCATE TABLE users; //ลบข้อมูลในตารางทั้งหมด
SET FOREIGN_KEY_CHECKS = 0;
TRUNCATE TABLE users;
SET FOREIGN_KEY_CHECKS = 1;


Object 3D
1.กดแล้วโชว์ ไม่เข้าเครื่อง
2.มีไฟล์แต่ดูไม่ได้ ต้องกดที่โปรไฟล์เจ้าของแล้วค่อยหาไฟล์เปิดดู
2.1 upload เข้าโปรไฟล์ตัวเอง

