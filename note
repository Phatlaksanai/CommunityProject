ตาราง database
create table users(
    user_id int auto_increment primary key,
    username varchar(255),
    password varchar(255),
    email varchar(255),
    otp varchar(6),
    otp_expire datetime
);

ALTER TABLE users ADD UNIQUE(email); //email เดิมจะ insert ไม่ได้ซ้ำอีก
TRUNCATE TABLE users; //ลบข้อมูลในตารางทั้งหมด


Object 3D
