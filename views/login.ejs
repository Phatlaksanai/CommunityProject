<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Temu Login</title>
    <link rel="stylesheet" href="Login.css">
</head>

<body>
    <div class="login-container">
        <div class="left-panel">
            <h1>Temu</h1>
            <p>Welcome to Temu community<br>There is a lot of fun !!!!</p>
        </div>
        <div class="right-panel">
            <h2>Login</h2>
            <% if (typeof error !== "undefined") { %>
                <div style="color:red; margin-bottom:10px;">
                    <%= error %>
                </div>
            <% } %>
            <% if (typeof success !== "undefined") { %>
                <div style="color:#00ff00; margin-bottom:10px;">
                    <%= success %>
                </div>
            <% } %>
            <form action="/login" method="POST" class="form-login">
                <label for="username">Username</label>
                <input type="text" id="username" name="username" required>

                <label for="password">Password</label>
                <input type="password" id="password" name="password" required>

                <a href="#" class="forgot">forgot password</a>

                <div class="btns">
                    <a href="/register"><button type="button" class="create">create</button></a>
                    <a href=""><button type="submit" class="login-btn">login</button></a>
                </div>
            </form>
        </div>
    </div>
</body>

</html>