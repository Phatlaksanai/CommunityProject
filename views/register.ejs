<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Temu Login</title>
<link rel="stylesheet" href="register.css">
</head>
<body>
    <div class="register-container">
        <div class="left-panel">
            <h1>Temu</h1>
            <p>Welcome to Temu community<br>There is a lot of fun !!!!</p>
        </div>
        <div class="right-panel">
            <h2>Register</h2>
            <form class = "form-register">

                <div id="step1" class="step active">
                    <label for="username">Username</label>
                    <input type="text" id="username">

                    <label for="password">Password</label>
                    <input type="password" id="password">

                    <label for="Confirm password">Confirm Password</label>
                    <input type="password" id="password2">

                    <div class="btns">
                        <!-- <button type="button" class="create">create</button> -->
                        <button type="button" onclick="nextStep()" class="next">Next</button>
                    </div>
                    
                </div>

                <div id="step2" class="step">
                    <label for="gamil">gmail</label>
                    <input type="email" id="email">

                    <label for="OTP">รหัส OTP</label>
                    <input type="text" id="otp">

                    <div class="btns">
                        <button type="button" onclick="prevStep()" class="back">Back</button>
                        <a href="/login"><button type="submit" class="submit">submit</button></a>
                    </div>
                </div>

            </form>
            <script>
                function nextStep() {
                    document.getElementById("step1").classList.remove("active");
                    document.getElementById("step2").classList.add("active");
                }

                function prevStep() {
                    document.getElementById("step2").classList.remove("active");
                    document.getElementById("step1").classList.add("active");
                }
            </script>
        </div>
    </div>
</body>
</html>
