    <div class = "TopPage">
        <h1 class = "Logo">Temu</h1>
        <div class="menubar">
            <a href=""><button id="Home" class="button">Home</button></a>
            <a href="/report"><button id="report" class="button">Report</button></a>
            <a href="/upload"><button id="upload" class="button">Upload</button></a>  
            <a href="/register"><button id="register" class="button">Register</button></a>
            <a href="/login"><button id="login" class="button">Login</button></a>
        </div>
        <% if (typeof profilename !== "undefined") { %>
            <div style="color:#ffffff; position: absolute; right: 100px;">
                <%= profilename %>
            </div>
